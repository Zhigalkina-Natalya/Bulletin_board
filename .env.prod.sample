# Django secret key (замени на свой реальный ключ)
SECRET_KEY=
# Debug mode (True для разработки, False для продакшена)
DEBUG=False

# Настройки подключения к PostgreSQL
POSTGRES_DB=bulletin_board
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_PASSWORD>
POSTGRES_HOST=db
POSTGRES_PORT=5432


ALLOWED_HOSTS=<YOUR_HOSTS_COMMA_SEPARATED>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0